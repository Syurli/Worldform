{
  "name": "@worldform/mcp",
  "version": "0.1.0-alpha.1",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "worldform-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @worldform/example-adapter build",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@worldform/adapter-api": "workspace:*",
    "@worldform/core": "workspace:*",
    "@worldform/workspace": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.13.3",
    "@worldform/example-adapter": "workspace:*",
    "esbuild": "0.28.2"
  }
}
