{
  "name": "@worldform/cli",
  "version": "0.1.0-alpha.1",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "worldform": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @worldform/example-adapter build",
    "test": "vitest run"
  },
  "dependencies": {
    "@worldform/adapter-api": "workspace:*",
    "@worldform/adapter-sdk": "workspace:*",
    "@worldform/core": "workspace:*",
    "@worldform/workspace": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@worldform/example-adapter": "workspace:*",
    "esbuild": "0.28.2"
  }
}
